#
# Keeps the containers away from the instance metadata service (169.254.0.0/16),
# where the VM's own identity is served: the credentials the backups use to
# write to Object Storage. Only the host needs it; no container does.
# DNS is the exception: 169.254.169.254 is also Oracle's resolver, which
# containers outside compose's networks (image builds, the default bridge)
# query directly; compose's own go through Docker's resolver on the host.
# Port 53 alone is let through, before the drop: the identity is served over
# HTTP, which stays blocked.
# DOCKER-USER is the chain Docker leaves to the administrator and checks first
# for every packet a container sends out; Docker recreates its chains when it
# starts, so this runs after it, every time (PartOf). Installed by
# apply-host-hardening.sh.

[Unit]
Description=Block the instance metadata service from Docker containers (BCM)
After=docker.service
Requires=docker.service
PartOf=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'iptables -C DOCKER-USER -d 169.254.0.0/16 -j DROP 2>/dev/null || iptables -I DOCKER-USER 1 -d 169.254.0.0/16 -j DROP'
ExecStart=/bin/sh -c 'iptables -C DOCKER-USER -d 169.254.169.254/32 -p tcp --dport 53 -j RETURN 2>/dev/null || iptables -I DOCKER-USER 1 -d 169.254.169.254/32 -p tcp --dport 53 -j RETURN'
ExecStart=/bin/sh -c 'iptables -C DOCKER-USER -d 169.254.169.254/32 -p udp --dport 53 -j RETURN 2>/dev/null || iptables -I DOCKER-USER 1 -d 169.254.169.254/32 -p udp --dport 53 -j RETURN'

[Install]
WantedBy=docker.service
