# MySQL Configuration
DB_ROOT_PASSWORD=your_root_password_here
DB_USERNAME=bcm_user
DB_PASSWORD=your_db_password_here

# JWT Secret Key (Generate with: JwtKeyGenerator)
JWT_SECRET=generate_your_own_base64_key_here

# Email Configuration (Optional)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password_here
# Sender address; leave empty with Gmail. Required with Brevo & co., where
# MAIL_USERNAME is a login id (see bcm-v2-backend/.env.example).
MAIL_FROM=

# Shared secret between backend and ml services (X-Internal-Api-Key header).
# Leave empty for local dev; set a strong random value before exposing the
# ml service outside this Docker network.
ML_INTERNAL_API_KEY=

# Secret for the backend's /internal/** ops endpoints (X-Internal-Admin-Key
# header), e.g. changing an organization's subscription tier by hand. Empty
# = those endpoints are disabled (404). Generate with: openssl rand -hex 32
INTERNAL_ADMIN_API_KEY=

# Stripe subscription billing (test-mode keys only for now). Any empty value
# disables billing. See bcm-v2-backend/.env.example for where each comes from.
STRIPE_SECRET_KEY=
STRIPE_PRO_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# RSA key pair (base64) asserting org_id/manager_id on every backend->ml
# call (X-Internal-Claims JWT). ML_CLAIMS_PRIVATE_KEY goes to the backend
# only, INTERNAL_CLAIMS_PUBLIC_KEY to ml only — never both in one place.
# Generate with com.donatodev.bcm_backend.util.InternalClaimsKeyGenerator.
# Leave both empty for local dev (falls back to trusting org_id/manager_id
# from the query string, same posture as an empty ML_INTERNAL_API_KEY).
ML_CLAIMS_PRIVATE_KEY=
INTERNAL_CLAIMS_PUBLIC_KEY=