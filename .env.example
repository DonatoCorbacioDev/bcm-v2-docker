# Local development: every value below, secrets included, lives in .env.
#
# Production keeps only names and settings here. Each secret (the passwords,
# JWT_SECRET, JWT_SECRET_PREVIOUS, TOTP_ENCRYPTION_KEY, MAIL_PASSWORD,
# ML_INTERNAL_API_KEY, ML_CLAIMS_PRIVATE_KEY, INTERNAL_ADMIN_API_KEY, the
# Stripe keys, and ML_DB_URL) is a Docker secret, one file in secrets/
# (docker-compose.prod.yml); ops/secrets/move-secrets-from-env.sh moves them
# there from a .env like this one.

# MySQL Configuration
DB_ROOT_PASSWORD=your_root_password_here
DB_USERNAME=bcm_user
DB_PASSWORD=your_db_password_here

# Read-only MySQL account for the ML service (SELECT on contracts,
# counterparties and financial_values only). Leave empty locally: ml then
# uses DB_USERNAME/DB_PASSWORD. In production, create it with
# ops/mysql/create-ml-readonly-user.sh (the name here, the password a secret).
ML_DB_USERNAME=
ML_DB_PASSWORD=

# The account the backend runs with: rows only (SELECT, INSERT, UPDATE,
# DELETE on bcm). DB_USERNAME above then serves Flyway alone, at startup.
# Leave empty locally: the backend then uses DB_USERNAME/DB_PASSWORD. In
# production, create it with ops/mysql/create-app-runtime-user.sh, which
# sets the name here and the password as a secret.
DB_APP_USERNAME=
DB_APP_PASSWORD=

# Hosts the three application accounts accept connections from (an IP pattern).
# Leave empty locally (any host). Production: 172.19.%, the data network, whose
# subnet docker-compose.prod.yml fixes; ops/mysql/harden-accounts.sh applies it.
DB_ACCOUNT_HOST=

# JWT Secret Key (Generate with: JwtKeyGenerator)
JWT_SECRET=generate_your_own_base64_key_here
# Only while rotating JWT_SECRET (see the backend's docs/SECURITY.md).
JWT_SECRET_PREVIOUS=
# Two-factor secrets at rest; required in production:
# bash ops/secrets/create-totp-encryption-key.sh
TOTP_ENCRYPTION_KEY=

# Email Configuration (Optional)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password_here
# Sender address; leave empty with Gmail. Required with Brevo & co., where
# MAIL_USERNAME is a login id (see bcm-v2-backend/.env.example).
MAIL_FROM=

# Shared secret between backend and ml services (X-Internal-Api-Key header).
# Leave empty for local dev; set a strong random value before exposing the
# ml service outside this Docker network.
ML_INTERNAL_API_KEY=

# Secret for the backend's /internal/** ops endpoints (X-Internal-Admin-Key
# header), e.g. changing an organization's subscription tier by hand. Empty
# = those endpoints are disabled (404). Generate with: openssl rand -hex 32
INTERNAL_ADMIN_API_KEY=

# Stripe subscription billing (test-mode keys only for now). Any empty value
# disables billing. See bcm-v2-backend/.env.example for where each comes from.
STRIPE_SECRET_KEY=
STRIPE_PRO_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# RSA key pair (base64) asserting org_id/manager_id on every backend->ml
# call (X-Internal-Claims JWT). ML_CLAIMS_PRIVATE_KEY goes to the backend
# only, INTERNAL_CLAIMS_PUBLIC_KEY to ml only — never both in one place.
# Generate with com.donatodev.bcm_backend.util.InternalClaimsKeyGenerator.
# Leave both empty for local dev (falls back to trusting org_id/manager_id
# from the query string, same posture as an empty ML_INTERNAL_API_KEY).
ML_CLAIMS_PRIVATE_KEY=
INTERNAL_CLAIMS_PUBLIC_KEY=